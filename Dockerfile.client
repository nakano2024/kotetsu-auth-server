FROM node:22-slim

# 依存ツール（dumb-init は PID1 対策。git は Git 依存のパッケージがある場合に備えて）
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates dumb-init git \
  && rm -rf /var/lib/apt/lists/*

# /app を作業ディレクトリに
WORKDIR /app

COPY client/package*.json ./
RUN npm ci --no-audit --no-fund

ENV HOST=0.0.0.0
ENV PORT=3000
EXPOSE 3000 24678

ENTRYPOINT ["dumb-init", "--"]
CMD ["npm", "run", "dev"]
